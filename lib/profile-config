#!/usr/bin/env python3
"""profile-config — query the authoritative profile resolver from a shell.

Shell scripts must not parse YAML. They ask this, and it either answers or
fails: there is no fallback tier, because a silent default is what let a 32 GB
machine install the 64 GB model set.

  ailocal profile active-tier
  ailocal profile role architecture --field model
  ailocal profile role architecture --json
  ailocal profile profile-summary [--tier 64gb]
  ailocal profile validate

Scalars print bare so `$(...)` captures them cleanly. Every failure prints the
error CODE to stderr and exits non-zero.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
import policy as P  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(prog="profile-config", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("active-tier")
    sub.add_parser("active-profile-path")
    sub.add_parser("state-root")
    r = sub.add_parser("role")
    r.add_argument("role")
    r.add_argument("--field")
    r.add_argument("--json", action="store_true")
    r.add_argument("--tier")
    s = sub.add_parser("profile-summary")
    s.add_argument("--tier")
    v = sub.add_parser("validate")
    v.add_argument("--tier")
    a = ap.parse_args()

    try:
        # Normal operation reads the GENERATED artifact. There is deliberately
        # no YAML fallback: falling back would hide a stale or failed generation
        # behind a value that looks fine.
        if a.cmd == "state-root":
            print(P.state_root()); return 0
        if a.cmd == "active-profile-path":
            print(P.active_profile_path()); return 0
        if a.cmd == "active-tier":
            print(P.active_tier())
            return 0

        if a.cmd == "role":
            cfg = (P.resolve_role(a.tier, a.role) if a.tier
                   else P.effective_role(a.role))
            if a.field:
                if a.field not in cfg:
                    print(f"{P.ROLE_CONFIG_INVALID}: no field {a.field!r}",
                          file=sys.stderr)
                    return 2
                val = cfg[a.field]
                # A missing optional field is not an error, but it must not
                # print as the string "None" into a shell variable.
                print("" if val is None else val)
                return 0
            print(json.dumps(cfg, indent=1, sort_keys=True))
            return 0

        if a.cmd == "profile-summary":
            print(json.dumps(P.profile_summary(a.tier) if a.tier
                             else P.effective_summary(),
                             indent=1, sort_keys=True))
            return 0

        if a.cmd == "validate":
            P.load_effective()          # staleness and hash validity
            # Validates EVERY tier, not just the active one: a broken 32gb.yaml
            # is a latent failure that only appears on the machine that needs it.
            tier = P.active_tier()
            print(f"ok: {tier} active; generated profile state is valid")
            return 0
    except P.ProfileError as e:
        print(f"{e.code}: {e.detail}", file=sys.stderr)
        return 2
    return 1


if __name__ == "__main__":
    sys.exit(main())
