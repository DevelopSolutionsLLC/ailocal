+func TestMoERouterMixedPrecisionConfig(t *testing.T) {
+	mlxtest.Run(t, func(t *mlxtest.T) {
+		cfg := tinyMoEConfig()
+		cfg.HiddenSize, cfg.RouterScale = 128, 0.125
+		cfg.QuantGroupSize, cfg.QuantBits, cfg.QuantMode = 64, 4, "affine"
+		path := "language_model.model.layers.0.router.proj"
+		cfg.TensorQuant = map[string]*model.TensorQuantInfo{path + ".weight": {QuantType: "INT4", GroupSize: 64}}
+		data := []byte(`{"quantization":{"bits":4,"group_size":64,"language_model.model.layers.0.router.proj":{"bits":8,"group_size":64}}}`)
+		if err := applyRouterQuantOverrides(cfg, data); err != nil {
+			t.Fatal(err)
+		}
+		w, s, b := mlx.Quantize(variedLike(0.37, int(cfg.NumExperts), int(cfg.HiddenSize)), 64, 8, "affine")
+		tensors := map[string]*mlx.Array{path + ".weight": w, path + ".weight_scale": s, path + ".weight_qbias": b}
+		projection := model.MakeLinearLayer(tensors, path, cfg.QuantGroupSize, cfg.QuantBits, cfg.QuantMode, cfg.TensorQuant)
+		q, ok := projection.(*nn.QuantizedLinear)
+		if !ok || q.Bits != 8 || q.GroupSize != 64 {
+			t.Fatal("router did not retain its explicit INT8 configuration")
+		}
+		quantized := &Router{Proj: projection, Scale: onesLike(int(cfg.HiddenSize))}
+		dense := &Router{Proj: linearFromWeight(mlx.Dequantize(w, s, b, 64, 8, "affine", nil)), Scale: quantized.Scale}
+		x := variedLike(0.11, 1, 3, int(cfg.HiddenSize))
+		qs, qi := quantized.Forward(x, cfg)
+		ds, di := dense.Forward(x, cfg)
+		mlx.Eval(qs, qi, ds, di)
+		for i, v := range qs.Floats() {
+			d := v - ds.Floats()[i]
+			if d < -1e-5 || d > 1e-5 {
+				t.Fatalf("router probability mismatch: %g", d)
+			}
+		}
+		// Compare index arrays on-device without relying on their integer dtype.
+		diff := mlx.Sub(qi.AsType(mlx.DTypeFloat32), di.AsType(mlx.DTypeFloat32)).Abs()
+		mlx.Eval(diff)
+		for _, v := range diff.Floats() {
+			if v != 0 {
+				t.Fatal("router selected different experts")
+			}
+		}
+	})
 }
 
