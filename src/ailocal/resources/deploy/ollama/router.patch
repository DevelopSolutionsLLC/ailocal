+// applyRouterQuantOverrides preserves the mixed-precision router declarations
+// from MLX config.json; imported tensor blobs may only carry the global INT4.
+func applyRouterQuantOverrides(cfg *TextConfig, data []byte) error {
+	var config struct {
+		Quantization       map[string]json.RawMessage `json:"quantization"`
+		QuantizationConfig map[string]json.RawMessage `json:"quantization_config"`
+	}
+	if err := json.Unmarshal(data, &config); err != nil {
+		return err
+	}
+	entries := config.Quantization
+	if len(entries) == 0 {
+		entries = config.QuantizationConfig
+	}
+	for path, raw := range entries {
+		if !strings.HasSuffix(path, ".router.proj") {
+			continue
+		}
+		var q struct {
+			Bits      int    `json:"bits"`
+			GroupSize int    `json:"group_size"`
+			Mode      string `json:"mode"`
+		}
+		if err := json.Unmarshal(raw, &q); err != nil {
+			return fmt.Errorf("router quantization %s: %w", path, err)
+		}
+		if (q.Bits != 4 && q.Bits != 8) || q.GroupSize <= 0 || (q.Mode != "" && q.Mode != "affine") {
+			return fmt.Errorf("unsupported router quantization for %s", path)
+		}
+		if cfg.TensorQuant == nil {
+			cfg.TensorQuant = make(map[string]*model.TensorQuantInfo)
+		}
+		cfg.TensorQuant[path+".weight"] = &model.TensorQuantInfo{QuantType: fmt.Sprintf("INT%d", q.Bits), GroupSize: q.GroupSize}
+	}
+	return nil
+}
