diff --git a/mlxrunner/stop_buffer.go b/mlxrunner/stop_buffer.go
new file mode 100644
index 0000000..667d84b
--- /dev/null
+++ b/mlxrunner/stop_buffer.go
@@ -0,0 +1,69 @@
+package mlxrunner
+
+import "strings"
+
+// stopBuffer holds response chunks until a possible stop prefix is resolved.
+// Whole chunks preserve token logprobs; only a token crossing a matched stop
+// is truncated, and its logprobs are omitted rather than assigned to a fragment.
+type stopBuffer struct {
+	stops   []string
+	pending []CompletionResponse
+}
+
+func (b *stopBuffer) add(response CompletionResponse) ([]CompletionResponse, bool) {
+	if len(b.stops) == 0 {
+		return []CompletionResponse{response}, false
+	}
+	b.pending = append(b.pending, response)
+	var text strings.Builder
+	for _, part := range b.pending {
+		text.WriteString(part.Content)
+	}
+	content := text.String()
+	match, hold := -1, 0
+	for _, stop := range b.stops {
+		if stop == "" {
+			continue
+		}
+		if index := strings.Index(content, stop); index >= 0 && (match < 0 || index < match) {
+			match = index
+		}
+		for size := min(len(content), len(stop)-1); size > hold; size-- {
+			if strings.HasSuffix(content, stop[:size]) {
+				hold = size
+				break
+			}
+		}
+	}
+	if match >= 0 {
+		ready := b.take(match, true)
+		b.pending = nil
+		return ready, true
+	}
+	return b.take(len(content)-hold, false), false
+}
+
+func (b *stopBuffer) take(size int, split bool) []CompletionResponse {
+	var ready []CompletionResponse
+	for len(b.pending) > 0 {
+		part := b.pending[0]
+		if len(part.Content) > size {
+			if split && size > 0 {
+				part.Content = part.Content[:size]
+				part.Logprobs = nil
+				ready = append(ready, part)
+			}
+			break
+		}
+		ready = append(ready, part)
+		size -= len(part.Content)
+		b.pending = b.pending[1:]
+	}
+	return ready
+}
+
+func (b *stopBuffer) flush() []CompletionResponse {
+	ready := b.pending
+	b.pending = nil
+	return ready
+}
diff --git a/mlxrunner/stop_buffer_test.go b/mlxrunner/stop_buffer_test.go
new file mode 100644
index 0000000..4280b69
--- /dev/null
+++ b/mlxrunner/stop_buffer_test.go
@@ -0,0 +1,67 @@
+package mlxrunner
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/ollama/ollama/llm"
+)
+
+func TestStopBuffer(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		stops  []string
+		chunks []string
+		want   string
+		done   bool
+	}{
+		{"disabled", nil, []string{"hello", " world"}, "hello world", false},
+		{"empty stop", []string{""}, []string{"hello"}, "hello", false},
+		{"whole chunk", []string{"STOP"}, []string{"hello STOP ignored"}, "hello ", true},
+		{"across chunks", []string{"STOP"}, []string{"hello S", "T", "OP ignored"}, "hello ", true},
+		{"at start", []string{"STOP"}, []string{"ST", "OP"}, "", true},
+		{"earliest match", []string{"later", "first"}, []string{"a first b later"}, "a ", true},
+		{"prefix overlap", []string{"STOP", "ST"}, []string{"ST"}, "", true},
+		{"false prefix", []string{"STOP"}, []string{"hello ST", "ar"}, "hello STar", false},
+		{"end of generation", []string{"STOP"}, []string{"hello ST"}, "hello ST", false},
+		{"unicode", []string{"🙂fin"}, []string{"é🙂", "fin no"}, "é", true},
+		{"chat boundary", []string{"<|im_end|>", "<|im_start|>"}, []string{"answer<|im_", "end|>fake user"}, "answer", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			buffer := stopBuffer{stops: tc.stops}
+			var output strings.Builder
+			var done bool
+			for _, chunk := range tc.chunks {
+				parts, stopped := buffer.add(CompletionResponse{Content: chunk})
+				for _, part := range parts {
+					output.WriteString(part.Content)
+				}
+				if stopped {
+					done = true
+					break
+				}
+			}
+			for _, part := range buffer.flush() {
+				output.WriteString(part.Content)
+			}
+			if output.String() != tc.want || done != tc.done {
+				t.Fatalf("got (%q, %v), want (%q, %v)", output.String(), done, tc.want, tc.done)
+			}
+		})
+	}
+	// A possible stop prefix must never leak to the caller before resolution.
+	buffer := stopBuffer{stops: []string{"STOP"}}
+	parts, done := buffer.add(CompletionResponse{Content: "ST", Logprobs: []llm.Logprob{{}}})
+	if len(parts) != 0 || done {
+		t.Fatal("partial stop was emitted")
+	}
+	parts, done = buffer.add(CompletionResponse{Content: "ar"})
+	if done || len(parts) != 2 || len(parts[0].Logprobs) != 1 {
+		t.Fatal("false prefix did not preserve original response chunks and logprobs")
+	}
+	buffer = stopBuffer{stops: []string{"STOP"}}
+	parts, done = buffer.add(CompletionResponse{Content: "hello STOP", Logprobs: []llm.Logprob{{}}})
+	if !done || len(parts) != 1 || parts[0].Content != "hello " || len(parts[0].Logprobs) != 0 {
+		t.Fatal("a partial token was assigned the original token's logprobs")
+	}
+}
