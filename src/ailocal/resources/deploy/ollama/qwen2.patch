index 0000000..55bc7a8
--- /dev/null
+++ b/mlxrunner/model/qwen2/qwen2_test.go
@@ -0,0 +1,83 @@
+package qwen2
+
+import (
+	"testing"
+
+	"github.com/ollama/ollama/mlx"
+	"github.com/ollama/ollama/mlx/mlxtest"
+	"github.com/ollama/ollama/mlxrunner/model"
+	"github.com/ollama/ollama/mlxrunner/nn"
+)
+
+func TestRegistersQwen2(t *testing.T) {
+	if !model.SupportsArchitecture("Qwen2ForCausalLM") {
+		t.Fatal("Qwen2ForCausalLM is not registered")
+	}
+}
+
+// Qwen2 checkpoints carry Q/K/V biases; dropping them loads without error and
+// silently corrupts attention, so the load must keep them and apply them.
+func TestLoadWeightsKeepsProjectionBiases(t *testing.T) {
+	mlxtest.Run(t, func(t *mlxtest.T) {
+		const hidden, heads, kvHeads, headDim, inter = 8, 2, 1, 4, 16
+		zeros := func(shape ...int) *mlx.Array { return mlx.Zeros(mlx.DTypeFloat32, shape...) }
+		bias := func(n int, base float32) *mlx.Array {
+			values := make([]float32, n)
+			for i := range values {
+				values[i] = base + float32(i)
+			}
+			return mlx.FromValues(values, n)
+		}
+		p := "model.layers.0"
+		tensors := map[string]*mlx.Array{
+			"model.embed_tokens.weight":            zeros(32, hidden),
+			"model.norm.weight":                    zeros(hidden),
+			p + ".input_layernorm.weight":          zeros(hidden),
+			p + ".post_attention_layernorm.weight": zeros(hidden),
+			p + ".self_attn.q_proj.weight":         zeros(heads*headDim, hidden),
+			p + ".self_attn.q_proj.bias":           bias(heads*headDim, 1),
+			p + ".self_attn.k_proj.weight":         zeros(kvHeads*headDim, hidden),
+			p + ".self_attn.k_proj.bias":           bias(kvHeads*headDim, 10),
+			p + ".self_attn.v_proj.weight":         zeros(kvHeads*headDim, hidden),
+			p + ".self_attn.v_proj.bias":           bias(kvHeads*headDim, 20),
+			p + ".self_attn.o_proj.weight":         zeros(hidden, heads*headDim),
+			p + ".mlp.gate_proj.weight":            zeros(inter, hidden),
+			p + ".mlp.up_proj.weight":              zeros(inter, hidden),
+			p + ".mlp.down_proj.weight":            zeros(hidden, inter),
+		}
+		cfg := &Config{HiddenSize: hidden, NumHiddenLayers: 1, NumAttentionHeads: heads,
+			NumKeyValueHeads: kvHeads, HeadDim: headDim, RMSNormEps: 1e-6, TieWordEmbeddings: true}
+		m := &Model{Layers: make([]*Layer, 1), Config: cfg}
+		if err := m.LoadWeights(tensors); err != nil {
+			t.Fatalf("LoadWeights: %v", err)
+		}
+		attention := m.Layers[0].Attention
+		x := mlx.AddScalar(zeros(1, 3, hidden), 0.5)
+		for name, c := range map[string]struct {
+			layer nn.LinearLayer
+			base  float32
+			n     int
+		}{
+			"q_proj": {attention.QProj, 1, heads * headDim},
+			"k_proj": {attention.KProj, 10, kvHeads * headDim},
+			"v_proj": {attention.VProj, 20, kvHeads * headDim},
+		} {
+			// Zero weights isolate the bias: every position must equal it.
+			out := c.layer.Forward(x)
+			mlx.Eval(out)
+			got := out.Floats()
+			if len(got) != 3*c.n {
+				t.Fatalf("%s output has %d values, want %d", name, len(got), 3*c.n)
+			}
+			for i, v := range got {
+				if want := c.base + float32(i%c.n); v != want {
+					t.Fatalf("%s output[%d] = %g, want bias %g", name, i, v, want)
+				}
+			}
+		}
+		delete(tensors, p+".self_attn.k_proj.weight")
+		if err := (&Model{Layers: make([]*Layer, 1), Config: cfg}).LoadWeights(tensors); err == nil {
+			t.Fatal("missing k_proj weight was not reported")
+		}
+	})
+}
