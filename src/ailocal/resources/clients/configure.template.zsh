# Sourced first in ~/.zshrc; must print nothing (corrupts p10k / OSC 633).

# VSCODE_INJECTION covers remotes where TERM_PROGRAM is not propagated.
if [[ "$TERM_PROGRAM" == "vscode" || -n "$VSCODE_INJECTION" ]]; then
  _AILOCAL_VSCODE=1
  # p10k instant prompt corrupts OSC 633 markers → agent terminal cmds hang.
  typeset -g POWERLEVEL9K_INSTANT_PROMPT=off
fi

# Process-scoped env only, so plain `claude` / `codex` stay on the cloud.

# Set the caller's `key` and `base`; one key owner, the generated env file.
_ailocal_endpoint() {
  local state="${AILOCAL_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/ailocal}"
  key=$(grep '^LITELLM_MASTER_KEY=' "$state/env" 2>/dev/null | cut -d= -f2-)
  base="${AILOCAL_PROXY:-http://127.0.0.1:${AILOCAL_LITELLM_PORT:-4000}}"
  if [[ -z "$key" ]]; then
    echo "$1: no key in ${state}/env — run ailocal install" >&2
    return 1
  fi
}

claude-local() {
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/ailocal"
  local base key
  _ailocal_endpoint claude-local || return 1
  # Slots remap built-in model slots to served aliases; generated from
  # profiles/clients.toml `claude.slots`. An array, so markers can sit inside.
  # ENABLE_TOOL_SEARCH=true: Claude Code turns deferral off for non-first-party
  # URLs; forcing it cut tool schema 63% (needs LiteLLM ≥ 1.98).
  local -a slots
  # >>> BEGIN GENERATED claude slots — do not edit <<<
  slots=(
    ANTHROPIC_DEFAULT_OPUS_MODEL="ailocal-primary"
    ANTHROPIC_DEFAULT_SONNET_MODEL="ailocal-primary"
    ANTHROPIC_DEFAULT_HAIKU_MODEL="ailocal-fast"
    ANTHROPIC_DEFAULT_FABLE_MODEL="ailocal-primary"
  )
  # >>> END GENERATED claude slots <<<

  # AILOCAL_<ROLE>_ALIAS_OVERRIDE points a role at an existing alias for this
  # process; an unserved alias fails closed, else the wrong model is measured.
  local -A _ailocal_ovr=()
  local _slot _role _var
  for _slot in "${slots[@]}"; do
    _role="${${_slot#*=}#ailocal-}"
    _var="AILOCAL_${_role:u}_ALIAS_OVERRIDE"
    _ailocal_ovr[${_slot%%=*}]="${(P)_var:-}"
  done
  # Workflow's 21 KB schema cannot be deferred (anthropics/claude-code#54716)
  # and went unused locally; AILOCAL_NATIVE_WORKFLOWS=1 restores it.
  local -a _workflow_env=()
  if [[ "${AILOCAL_NATIVE_WORKFLOWS:-}" != "1" ]]; then
    _workflow_env=(CLAUDE_CODE_DISABLE_WORKFLOWS=1)
  fi

  # settings.json "model" outranks slot vars, so the OPUS override is --model.
  local -a _model_args=()
  [[ -n "${_ailocal_ovr[ANTHROPIC_DEFAULT_OPUS_MODEL]:-}" ]] && \
    _model_args=(--model "${_ailocal_ovr[ANTHROPIC_DEFAULT_OPUS_MODEL]}")
  local _ailocal_models="" _i _name _val
  for _name in ${(k)_ailocal_ovr}; do
    [[ -n "${_ailocal_ovr[$_name]}" ]] || continue
    if [[ -z "$_ailocal_models" ]]; then
      # Bounded retry so transient proxy load is not a launch failure.
      _ailocal_models=$(curl -fsS --max-time 5 \
        --retry 3 --retry-delay 1 --retry-connrefused --retry-all-errors \
        -H "Authorization: Bearer $key" \
        "$base/v1/models" 2>/dev/null) || {
        echo "claude-local: cannot reach $base/v1/models to validate an alias override" >&2
        return 1
      }
    fi
    _val="${_ailocal_ovr[$_name]}"
    if [[ "$_ailocal_models" != *"\"$_val\""* ]]; then
      echo "claude-local: alias override '$_val' ($_name) is not served by LiteLLM" >&2
      return 1
    fi
    for (( _i = 1; _i <= ${#slots[@]}; _i++ )); do
      [[ "${slots[_i]%%=*}" == "$_name" ]] && slots[_i]="$_name=$_val"
    done
  done

  # API_TIMEOUT_MS = LiteLLM `timeout: 900`: cold prefill is super-linear, so
  # client and proxy must agree. 1M context off: backends cap at num_ctx.
  env "${slots[@]}" \
    CLAUDE_CONFIG_DIR="$cfg/claude" \
    ANTHROPIC_BASE_URL="$base" ANTHROPIC_API_KEY="$key" \
    LOCAL_AGENT_CALLER=local \
    CLAUDE_CODE_DISABLE_1M_CONTEXT=1 \
    ENABLE_TOOL_SEARCH=${AILOCAL_TOOL_SEARCH:-true} \
    "${_workflow_env[@]}" \
    API_TIMEOUT_MS="${AILOCAL_API_TIMEOUT_MS:-900000}" \
    claude "${_model_args[@]}" "$@"
}

codex-local() {
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/ailocal"
  local base key
  _ailocal_endpoint codex-local || return 1
  CODEX_HOME="$cfg/codex" OPENAI_API_KEY="$key" OPENAI_BASE_URL="$base/v1" \
    command codex -c 'mcp_servers.agent.env.LOCAL_AGENT_CALLER="local"' \
      -c 'mcp_servers.agent.enabled_tools=["model_guide"]' "$@"
}

# No `--profile ailocal`: that creates an empty profile w/o the config.
ailocal-code() { code "${1:-.}"; }
