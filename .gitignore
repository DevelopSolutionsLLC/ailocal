# Environment and generated secrets — never commit
.env
.env.local
*.env.local

# Active-profile MARKER — one line (e.g. "64gb"), written by install.sh from detected RAM.
# Machine-specific, so gitignored. It only names which tracked config/profiles/<tier>.yaml is
# active; the profiles themselves are the committed source of truth. `--profile <tier>` overrides.
config/active-profile

# Data, logs, and backups — contain runtime state and may contain secrets
/data/
/logs/
/backups/

# Backup archives (defence in depth — /backups/ above already covers the directory)
*.tar.gz
*.tar.bz2

# Key and certificate files — should never be committed
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# macOS
.DS_Store
*.swp
*.swo
*~

# IDEs and AI coding tools
.vscode/
.idea/
*.iml
.claude/
# /AGENTS.md is NO LONGER IGNORED. It was, back when a root AGENTS.md could only be
# tool-generated; it is now this repo's canonical instruction file (it replaced
# CLAUDE.md), so ignoring it would silently drop the primer from every clone.

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.grepai/

# Cadence writes a marker-delimited block into this repo's deployed agent files and backs the
# originals up first. Neither lives in the repo, but ignore them so a stray copy is never committed.
*.pre-cadence-*

# Generated runtime cache (regenerated by sync-models.sh at install)
config/capabilities.generated.json

# Generated from config/clients/copilot/repo-instructions.md by install-clients.sh.
# Was hand-maintained and drifted (stale capability table, pointed at a deleted file).
.github/copilot-instructions.md
