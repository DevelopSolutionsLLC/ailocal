# Secrets — never commit
.env
.env.local
*.env.local
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# The one generated file that lands inside the checkout. Everything else
# generation produces lives under $AILOCAL_STATE, outside the tree.
.github/copilot-instructions.md

# Guard only: runtime state belongs in $AILOCAL_STATE. These stay so a script
# that regresses to a repo-relative path cannot commit runtime state.
/data/
/logs/
/backups/
/captures/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/

# Editor, OS and local tool state
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/
*.iml
.claude/
.grepai/
