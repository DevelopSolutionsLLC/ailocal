#!/usr/bin/env bash
# ailocal — thin CLI dispatcher over the scripts/ in this repo.
#
#   ailocal status     live model status by capability, verbose (scripts/status.sh)
#   ailocal models     compact capability -> backend -> status table
#   ailocal validate   end-to-end sanity: capabilities, backends, client mappings, aliases, sync
#   ailocal validate --runtime   also probe the live proxy: /v1/models, advertised contexts, embeddings
#   ailocal doctor     health check (scripts/doctor.sh)
#   ailocal benchmark  developer benchmark suites (models|planner|gateway)
#   ailocal security   container pins, digest drift, reachability (--scan for CVEs)
#   ailocal sync       regenerate derived configs
#   ailocal start|stop|update|smoke    lifecycle
#   ailocal resolve <capability>       print the active Ollama backend tag
#
# Put it on PATH once:  ln -sf "$(pwd)/scripts/ailocal" /usr/local/bin/ailocal
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPTS="$ROOT_DIR/scripts"
# No default action. A bare command name prints usage rather than doing work —
# the same contract as `cadence`, and the reason is the same: a command that acts
# when invoked with no arguments is a command you cannot safely explore.
cmd="${1:-help}"; shift || true

case "$cmd" in
  status)   exec bash "$SCRIPTS/status.sh" "$@" ;;
  models)   exec bash "$SCRIPTS/status.sh" --table ;;
  validate) exec bash "$SCRIPTS/validate.sh" "$@" ;;
  doctor)  exec bash "$SCRIPTS/doctor.sh" "$@" ;;
  security) exec bash "$SCRIPTS/security.sh" "$@" ;;
  sync)    exec python3 "$SCRIPTS/sync-models.py" "$@" ;;
  start)   exec bash "$SCRIPTS/start.sh" "$@" ;;
  stop)    exec bash "$SCRIPTS/stop.sh" "$@" ;;
  update)  exec bash "$SCRIPTS/update.sh" "$@" ;;
  smoke)   exec bash "$SCRIPTS/smoke-test.sh" "$@" ;;
  resolve) exec python3 "$SCRIPTS/sync-models.py" --resolve "$@" ;;
  # Client deployment and the lifecycle actions that used to be run as
  # ./scripts/<name>.sh. Those files are now internal; this is the supported entry.
  clients)  exec bash "$SCRIPTS/install-clients.sh" "$@" ;;
  vscode)   exec bash "$SCRIPTS/install-vscode.sh" "$@" ;;
  models-install) exec bash "$SCRIPTS/install-models.sh" "$@" ;;
  audit)    exec bash "$SCRIPTS/audit-installation.sh" "$@" ;;
  cleanup)  exec bash "$SCRIPTS/cleanup-installation.sh" "$@" ;;
  teardown) exec bash "$SCRIPTS/teardown.sh" "$@" ;;
  trace)    exec bash "$SCRIPTS/request-trace.sh" "$@" ;;
  metrics)  exec python3 "$SCRIPTS/gateway-metrics.py" "$@" ;;
  # benchmark <suite> [...] — the one entry point to the benchmark subsystem.
  benchmark)
    suite="${1:-help}"; shift || true
    case "$suite" in
      models)  exec python3 "$SCRIPTS/benchmarks/models" "$@" ;;
      planner) exec python3 "$SCRIPTS/benchmarks/planner-comparison.py" "$@" ;;
      gateway) exec bash   "$SCRIPTS/benchmarks/tool-gateway.sh" "$@" ;;
      *)
        cat >&2 <<'BENCH'
usage: ailocal benchmark <suite> [options]

  models    evaluate candidate models (plan | run | probe | client |
            setup | doctor | report)
  planner   blinded A/B of planner candidates on a fixed scenario
  gateway   A/B the tool gateway on a real client, report vs filter

Benchmarks are a developer utility: they never modify a profile, and they are
not part of install, update or the regression gate.
BENCH
        [ "$suite" = help ] && exit 0 || exit 2 ;;
    esac ;;
  e2e)      # e2e <claude|codex|vscode>
            case "${1:-}" in
              claude) shift; exec bash "$SCRIPTS/validate-claude-e2e.sh" "$@" ;;
              codex)  shift; exec bash "$SCRIPTS/validate-codex-e2e.sh"  "$@" ;;
              vscode) shift; exec bash "$SCRIPTS/validate-vscode-e2e.sh" "$@" ;;
              *) echo "ailocal e2e {claude|codex|vscode}" >&2; exit 1 ;;
            esac ;;
  help|-h|--help) cat <<'USAGE'
ailocal — local model runtime

  status | models | doctor | validate | smoke     inspect
  security [--scan|--check-updates]              container supply chain
  start | stop | update | sync                    lifecycle
  clients | vscode | models-install               deploy
  audit | cleanup | teardown                      installation
  trace | metrics | e2e <client>                  diagnostics
  resolve <capability>                            print the active backend
USAGE
     exit 0 ;;
  *) echo "ailocal: unknown command '$cmd' — run 'ailocal help'" >&2; exit 1 ;;
esac
