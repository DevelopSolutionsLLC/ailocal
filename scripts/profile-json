#!/usr/bin/env python3
"""profile-json — read one scalar out of a profile-summary JSON on stdin.

Exists so doctor.sh can pull four values from ONE resolver invocation instead of
shelling out four times, without reintroducing grep/sed parsing of structured
output. Deliberately trivial: path segments in, scalar out.
"""
import json
import sys

try:
    data = json.load(sys.stdin)
    for key in sys.argv[1:]:
        data = data[key]
except Exception as exc:  # noqa: BLE001
    print(f"profile-json: {type(exc).__name__}", file=sys.stderr)
    sys.exit(2)
print("" if data is None else data)
