#!/usr/bin/env bash
# ailocal — development shim. The real command is the installed console script
# `ailocal` (pyproject.toml -> ailocal.cli:main); this exists so the repository
# stays runnable from a checkout without installing anything, and is deleted
# once the installed entry point is the only supported surface (ADR 009).
#
# A checkout run is DECLARED, not guessed. policy.py resolves config and data to
# XDG locations; running against the working tree means saying so. Both roots
# point at the package's resource tree, which is the ONE copy of every shipped
# default -- the same bytes a wheel carries, editable in place during
# development, so a dev edit and a shipped default can never diverge.
#
# The command list lives in src/ailocal/cli.py and is rendered from one table.
# Do not restate it here.
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
export AILOCAL_CONFIG="${AILOCAL_CONFIG:-$ROOT_DIR}"
export AILOCAL_DATA="${AILOCAL_DATA:-$ROOT_DIR/src/ailocal/resources}"
export PYTHONPATH="$ROOT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -c 'import sys; from ailocal.cli import main; sys.exit(main(sys.argv[1:]))' "$@"
